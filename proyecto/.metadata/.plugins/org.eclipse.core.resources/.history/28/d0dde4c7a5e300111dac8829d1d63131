package gui;

import java.awt.BorderLayout;
import java.awt.FlowLayout;

import javax.swing.JButton;
import javax.swing.JDialog;
import javax.swing.JPanel;
import javax.swing.border.EmptyBorder;

import com.sun.tools.javac.Main;

import javax.swing.JLabel;
import javax.swing.JOptionPane;

import java.awt.Font;
import javax.swing.JTextField;
import java.awt.event.ActionListener;
import java.awt.event.ActionEvent;
import javax.swing.ImageIcon;
import javax.swing.JPasswordField;

public class Diseño_Login extends JDialog implements ActionListener {

	private static final long serialVersionUID = 1L;
	private final JPanel contentPanel = new JPanel();
	private JLabel lblNewLabel;
	private JLabel lblContrasea;
	private JTextField username;
	private JButton btnNewButton;
	private JButton btnCancelar;

	/**
	 * Launch the application.
	 */
	public static void main(String[] args) {
		try {
			Diseño_Login dialog = new Diseño_Login();
			dialog.setDefaultCloseOperation(JDialog.DISPOSE_ON_CLOSE);
			dialog.setVisible(true);
		} catch (Exception e) {
			e.printStackTrace();
		}
	}

	/**
	 * Create the dialog.
	 */
	public Diseño_Login() {
		setTitle("Pantalla de logeo");
		setBounds(100, 100, 450, 300);
		getContentPane().setLayout(new BorderLayout());
		contentPanel.setBorder(new EmptyBorder(5, 5, 5, 5));
		getContentPane().add(contentPanel, BorderLayout.CENTER);
		contentPanel.setLayout(null);
		{
			lblNewLabel = new JLabel("Username");
			lblNewLabel.setFont(new Font("Tahoma", Font.PLAIN, 20));
			lblNewLabel.setBounds(105, 20, 112, 27);
			contentPanel.add(lblNewLabel);
		}
		{
			lblContrasea = new JLabel("Contraseña");
			lblContrasea.setFont(new Font("Tahoma", Font.PLAIN, 20));
			lblContrasea.setBounds(105, 89, 112, 27);
			contentPanel.add(lblContrasea);
		}
		{
			username = new JTextField();
			username.setBounds(156, 52, 139, 27);
			contentPanel.add(username);
			username.setColumns(10);
		}
		{
			btnNewButton = new JButton("Ingresar\r\n");
			btnNewButton.addActionListener(this);
			btnNewButton.setFont(new Font("Tahoma", Font.PLAIN, 14));
			btnNewButton.setBounds(131, 163, 139, 27);
			contentPanel.add(btnNewButton);
		}
		{
			btnCancelar = new JButton("Salir");
			btnCancelar.addActionListener(this);
			btnCancelar.setFont(new Font("Tahoma", Font.PLAIN, 14));
			btnCancelar.setBounds(131, 213, 139, 27);
			contentPanel.add(btnCancelar);
		}
		{
			lblNewLabel_1 = new JLabel("");
			lblNewLabel_1.setIcon(new ImageIcon(Main.class.getResource("imagen/llavesita.jpg")));
			lblNewLabel_1.setBounds(198, 20, 81, 27);
			contentPanel.add(lblNewLabel_1);
		}
		{
			psfContra = new JPasswordField();
			psfContra.setBounds(156, 126, 139, 27);
			contentPanel.add(psfContra);
		}
	}
	int contador=3;
	private JLabel lblNewLabel_1;
	private JPasswordField psfContra;
	public void actionPerformed(ActionEvent e) {
		if (e.getSource() == btnCancelar) {
			do_btnCancelar_actionPerformed(e);
		}
		if (e.getSource() == btnNewButton) {
			do_btnNewButton_actionPerformed(e);
		}
	}
	protected void do_btnNewButton_actionPerformed(ActionEvent e) {
		String User = username.getText();
		String contra = new String(psfContra.getPassword());
		
		String UserCorrecto = "admin";
		String contraCorrecta = "12345";
		if(User.equals(UserCorrecto) && contra.equals(contraCorrecta)) {
			Diseño_Ventana_Principal dvp= new Diseño_Ventana_Principal(null, null);
			dvp.setVisible(true);
			
			this.dispose();
			
		}
		else {
			if(contador<0) {
				JOptionPane.showMessageDialog(this,"Intentos agotados","ADVERTENCIA",JOptionPane.WARNING_MESSAGE);
				username.setEditable(false);
				psfContra.setEditable(false);
				username.setText("");
				psfContra.setText("");
				
			}
			else {
				JOptionPane.showMessageDialog(this,"Username o contraseña incorrecto \n"
			+"te quedan "+contador+" intentos","ADVERTENCIA",JOptionPane.WARNING_MESSAGE);
				contador-=1;
			}
			
		}
		
	}
	protected void do_btnCancelar_actionPerformed(ActionEvent e) {
		this.dispose();	
	}
}
