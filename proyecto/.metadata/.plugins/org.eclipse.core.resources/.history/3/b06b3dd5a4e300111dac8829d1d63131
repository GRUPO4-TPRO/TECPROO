	public void actionPerformed(ActionEvent e) {
		if (e.getSource() == btnirAEl) {
			do_btnirAEl_actionPerformed(e);
		}
		if (e.getSource() == btnNewButton) {
			do_btnNewButton_actionPerformed(e);
		}
	}
	protected void do_btnNewButton_actionPerformed(ActionEvent e) {
		if(txtIdVent.getText().trim().isEmpty()||txtCodProd.getText().trim().isEmpty()||txtCliente.getText().trim().isEmpty()||txtDescrip.getText().trim().isEmpty()||
				txtCantidad.getText().trim().isEmpty()) {
			JOptionPane.showMessageDialog(this,"se necesita registrar todos los datos","ADVERTENCIA",JOptionPane.WARNING_MESSAGE);
		}
		else {
			int cod= Integer.parseInt(txtCodProd.getText());
			int idVent=Integer.parseInt(txtIdVent.getText());
			Clase_Producto p=le.Buscar(cod);
			Clase_Venta v=lisV.buscarVent(idVent);
			if(p!=null && v==null) {
				if(Integer.parseInt(txtCantidad.getText())>p.get_stock()) {
					JOptionPane.showMessageDialog(this,"cantidad insuficiente en el stock \n"
							+ "stock actual: "+p.get_stock()+" "+p.get_nom());
				}
				else {
					int cant=Integer.parseInt(txtCantidad.getText());
					p.set_stock(p.get_stock()-cant);
					
					double total= lisV.calcularTotalVenta(Integer.parseInt(txtCantidad.getText()),p.get_precio());
					lisV.Agregar(Integer.parseInt(txtIdVent.getText()),Integer.parseInt(txtCodProd.getText()),txtDescrip.getText(),
								Integer.parseInt(txtCantidad.getText()),p.get_precio(),total,txtCliente.getText());
						ListarVentas();
				}
				}
			else {
					JOptionPane.showMessageDialog(this,"El codigo del producto no existe o el id de la venta esta repetido");
				}
			txtIdVent.setText("");
			txtCodProd.setText("");
			txtCliente.setText("");
			txtDescrip.setText("");
			txtCantidad.setText("");
		}
		
		
	}
	protected void do_btnirAEl_actionPerformed(ActionEvent e) {
		Diseño_Stock Vstock=new Diseño_Stock(le,lisV);
