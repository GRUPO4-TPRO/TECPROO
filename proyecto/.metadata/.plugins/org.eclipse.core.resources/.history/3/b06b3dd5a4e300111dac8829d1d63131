	}
	public void ListarVentas() {
		modeloVentas.setRowCount(0);
	    double VentasToltalDeldia = 0;

	    for (int i = 0; i < lisV.Tamaño(); i++) {
	        Clase_Venta v = lisV.obtenerI(i);

	        Object[] fila = {
	        	v.getId_venta(),
	            v.getCod_producto(),
	            v.getCliente(),
	            v.getDescripcion(),
	            v.getCantidad(),
	            v.getPre_unitario(),
	            v.getPre_total()
	        };

	        modeloVentas.addRow(fila);
	        VentasToltalDeldia += v.getPre_total();
	    }

	    lblTotal.setText("VENTA TOTAL DEL DIA: S/ " + VentasToltalDeldia);
	}
